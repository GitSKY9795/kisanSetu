# --- App ---
ENV=development
DEBUG=true

# --- Database ---
# Leave unset to use the local SQLite default (backend/kisansetu.db). Uncomment + fill in
# only if you're switching to Postgres.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kisansetu

# --- Auth (Firebase — sole identity provider for every role: Farmer/Buyer/FPO/Admin) ---
# Same Firebase project as frontend/src/firebase.js. Generate a service account key from
# Firebase Console > Project Settings > Service Accounts, save it into backend/ (gitignored).
FIREBASE_PROJECT_ID=kisan-setu-3bbf5
GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json

# --- Agentic AI (Gemini — https://ai.google.dev, free tier) ---
GEMINI_API_KEY=

# --- BHASHINI (https://bhashini.gov.in — free govt API) ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# --- External data APIs ---
AGMARKNET_API_KEY=
OPENROUTESERVICE_API_KEY=

# --- Payments (Razorpay test mode — https://razorpay.com) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
