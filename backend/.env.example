# --- App ---
ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# --- Database ---
# Leave DATABASE_URL unset/commented to use the local SQLite default (sqlite:///./kisansetu.db) — this
# is what this prototype ships with. Uncomment + fill in only if you're switching to Postgres.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kisansetu

# --- Auth (Firebase — sole identity provider for every role) ---
# Same Firebase project as the frontend's src/firebase.js. Create a service account key
# from Firebase Console > Project Settings > Service Accounts > Generate new private key,
# save the JSON file into backend/ (it's gitignored — never commit it), and point
# GOOGLE_APPLICATION_CREDENTIALS at it.
FIREBASE_PROJECT_ID=kisan-setu-3bbf5
GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json

# --- Agentic AI (Gemini — https://ai.google.dev, free tier) ---
GEMINI_API_KEY=

# --- BHASHINI (https://bhashini.gov.in — free govt API) ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# --- External data APIs ---
AGMARKNET_API_KEY=
OPENROUTESERVICE_API_KEY=

# --- Payments (Razorpay test mode — https://razorpay.com) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Firebase SQL Connect (Data Connect) database — see docs/FIREBASE_SQL_CONNECT.md ---
# Leave CLOUD_SQL_INSTANCE empty to keep using the local SQLite file.
# CLOUD_SQL_INSTANCE=kisan-setu-3bbf5:asia-south1:kisansetu-fdc
# DB_NAME=kisansetu
# DB_USER=postgres
# DB_PASSWORD=
