# --- App ---
ENV=development
DEBUG=true

# --- Database ---
# Leave DATABASE_URL unset/commented to use the local SQLite default (sqlite:///./kisansetu.db) — this
# is what this prototype ships with. Uncomment + fill in only if you're switching to Postgres/Supabase.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kisansetu
REDIS_URL=redis://localhost:6379/0

# --- Supabase (https://supabase.com — free tier) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth / JWT ---
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Agentic AI (Gemini — https://ai.google.dev, free tier) ---
GEMINI_API_KEY=

# --- BHASHINI (https://bhashini.gov.in — free govt API) ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# --- External data APIs ---
AGMARKNET_API_KEY=
OPENROUTESERVICE_API_KEY=

# --- Payments (Razorpay test mode — https://razorpay.com) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
